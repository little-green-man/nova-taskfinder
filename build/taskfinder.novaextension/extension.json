						["pnpm", "pnpm"],
						["bun", "bun"]
					],
					"resolve": "taskfinder.package-manager.choices",
					"default": null
				},
				{
					"key": "taskfinder.show-lifecycle-scripts",
					"title": "Lifecycle Scripts",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "Show"],
						[false, "Hide"]
					],
					"resolve": "taskfinder.show-lifecycle-scripts.choices",
					"default": null
				}
			]
		},
		{
			"title": "Monorepos",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#monorepos",
			"children": [
				{
					"key": "taskfinder.workspace-packages",
					"title": "Workspace Packages",
					"description": "Also list tasks from workspace packages: npm, Yarn, pnpm and bun workspaces, and Deno workspaces.",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.workspace-packages.choices",
					"default": null
