{
	"identifier": "littlegreenman.TaskFinder",
	"name": "Automatic Tasks",
	"imageName": "icon",
	"organization": "Little Green Man Ltd",
	"description": "Automatically offers Composer, Node, Maidfile & Taskfile actions as Nova Tasks.",
	"version": "6.0.0",
	"categories": ["tasks"],
	"homepage": "https://github.com/little-green-man/nova-taskfinder",
	"repository": "https://github.com/little-green-man/nova-taskfinder",
	"bugs": "https://github.com/little-green-man/nova-taskfinder/issues",
	"main": "main.dist.js",
	"min_runtime": "2.0",
	"activationEvents": [
		"onWorkspaceContains:package.json",
		"onWorkspaceContains:composer.json",
		"onWorkspaceContains:*Taskfile.*",
		"onWorkspaceContains:maidfile"
	],
	"entitlements": {
		"filesystem": "readonly",
		"process": true
	},
	"config-workspace": [
		{
			"title": "Node Options",
			"description": "\"Global Setting\" uses the value from the extension's preferences.",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						["npm", "npm"],
						["yarn", "yarn"]
					],
					"default": null
				}
			]
		},
		{
			"title": "Autopopulation",
			"description": "\"Global Setting\" uses the value from the extension's preferences. Changes apply immediately.",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.auto-composer",
					"title": "Include Composer Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-node",
					"title": "Include Node Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Include Taskfile Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Include Maidfile Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				}
			]
		}
	],
	"config": [
		{
			"title": "Node Options",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"type": "enum",
					"radio": false,
					"values": [
						["npm", "npm"],
						["yarn", "yarn"]
					],
					"default": "npm"
				}
			]
		},
		{
			"title": "Autopopulation",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.auto-composer",
					"title": "Include Composer Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-node",
					"title": "Include Node Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Include Taskfile Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Include Maidfile Tasks",
					"type": "boolean",
					"default": true
				}
			]
		}
	]
}
