{
	"identifier": "littlegreenman.TaskFinder",
	"name": "Automatic Tasks",
	"imageName": "icon",
	"organization": "Little Green Man Ltd",
	"description": "Automatically offers Composer, Node, Maidfile & Taskfile actions as Nova Tasks.",
	"version": "7.0.0",
	"categories": ["tasks"],
	"homepage": "https://github.com/little-green-man/nova-taskfinder",
	"repository": "https://github.com/little-green-man/nova-taskfinder",
	"bugs": "https://github.com/little-green-man/nova-taskfinder/issues",
	"main": "main.dist.js",
	"min_runtime": "2.0",
	"activationEvents": [
		"onWorkspaceContains:package.json",
		"onWorkspaceContains:composer.json",
		"onWorkspaceContains:Taskfile.yml",
		"onWorkspaceContains:taskfile.yml",
		"onWorkspaceContains:Taskfile.yaml",
		"onWorkspaceContains:taskfile.yaml",
		"onWorkspaceContains:Taskfile.dist.yml",
		"onWorkspaceContains:taskfile.dist.yml",
		"onWorkspaceContains:Taskfile.dist.yaml",
		"onWorkspaceContains:taskfile.dist.yaml",
		"onWorkspaceContains:maidfile",
		"onWorkspaceContains:maidfile.toml",
		"onWorkspaceContains:maidfile.yaml",
		"onWorkspaceContains:maidfile.yml",
		"onWorkspaceContains:maidfile.json",
		"onWorkspaceContains:Maidfile",
		"onWorkspaceContains:Maidfile.toml"
	],
	"entitlements": {
		"filesystem": "readonly",
		"process": true
	},
	"config-workspace": [
		{
			"title": "Node Options",
			"description": "\"Global Setting\" uses the value from the extension's preferences.",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"description": "Automatic uses the packageManager field, then devEngines.packageManager, then the lockfile (bun, pnpm, yarn, then npm), falling back to npm.",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						["auto", "Automatic"],
						["npm", "npm"],
						["yarn", "yarn"],
						["pnpm", "pnpm"],
						["bun", "bun"]
					],
					"default": null
				}
			]
		},
		{
			"title": "Autopopulation",
			"description": "\"Global Setting\" uses the value from the extension's preferences. Changes apply immediately.",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.auto-composer",
					"title": "Include Composer Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-node",
					"title": "Include Node Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Include Taskfile Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Include Maidfile Tasks",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Enabled"],
						[false, "Disabled"]
					],
					"default": null
				},
				{
					"key": "taskfinder.show-lifecycle-scripts",
					"title": "Show Lifecycle Scripts",
					"description": "npm hooks (e.g. postinstall, prebuild) and Composer event scripts (e.g. post-install-cmd), which run automatically.",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Global Setting"],
						[true, "Show"],
						[false, "Hide"]
					],
					"default": null
				}
			]
		}
	],
	"config": [
		{
			"title": "Node Options",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"description": "Automatic uses the packageManager field, then devEngines.packageManager, then the lockfile (bun, pnpm, yarn, then npm), falling back to npm.",
					"type": "enum",
					"radio": false,
					"values": [
						["auto", "Automatic"],
						["npm", "npm"],
						["yarn", "yarn"],
						["pnpm", "pnpm"],
						["bun", "bun"]
					],
					"default": "auto"
				}
			]
		},
		{
			"title": "Autopopulation",
			"type": "section",
			"children": [
				{
					"key": "taskfinder.auto-composer",
					"title": "Include Composer Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-node",
					"title": "Include Node Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Include Taskfile Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Include Maidfile Tasks",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.show-lifecycle-scripts",
					"title": "Show Lifecycle Scripts",
					"description": "npm hooks (e.g. postinstall, prebuild) and Composer event scripts (e.g. post-install-cmd), which run automatically.",
					"type": "boolean",
					"default": false
				}
			]
		}
	]
}
