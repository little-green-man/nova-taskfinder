					],
					"resolve": "taskfinder.auto-artisan.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-vscode",
					"title": "VS Code (.vscode/tasks.json)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-vscode.choices",
					"default": null
				},
				{
					"title": "Refresh Tasks",
					"description": "Re-reads every source, e.g. after installing a tool.",
					"type": "command",
					"command": "taskfinder.refresh"
				}
			]
		},
		{
			"title": "Node and Composer",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#node-and-composer",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						["auto", "Automatic"],
						["npm", "npm"],
