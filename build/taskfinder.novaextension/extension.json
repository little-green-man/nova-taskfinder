				{
					"key": "taskfinder.auto-make",
					"title": "Make (Makefile)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-make.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-artisan",
					"title": "Laravel (artisan)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-artisan.choices",
					"default": null
				},
				{
					"title": "Refresh Tasks",
					"description": "Re-reads every source, e.g. after installing a tool.",
					"type": "command",
					"command": "taskfinder.refresh"
				}
			]
		},
		{
			"title": "Node and Composer",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#node-and-composer",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						["auto", "Automatic"],
						["npm", "npm"],
						["yarn", "yarn"],
						["pnpm", "pnpm"],
						["bun", "bun"]
					],
					"resolve": "taskfinder.package-manager.choices",
					"default": null
				},
				{
					"key": "taskfinder.show-lifecycle-scripts",
					"title": "Lifecycle Scripts",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "Show"],
						[false, "Hide"]
					],
					"resolve": "taskfinder.show-lifecycle-scripts.choices",
					"default": null
				}
			]
		},
		{
			"title": "just",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#just",
			"children": [
				{
					"key": "taskfinder.just-confirm-recipes",
					"title": "Recipes That Ask to Confirm",
					"type": "enum",
					"radio": true,
					"values": [
						[null, "Use Global Setting"],
						["exclude", "Hide"],
						["yes", "Show, and confirm when run"]
					],
					"resolve": "taskfinder.just-confirm-recipes.choices",
					"default": null
				}
			]
		},
		{
			"title": "Make",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#make",
			"children": [
				{
					"key": "taskfinder.make-listing",
					"title": "Find Targets By",
					"description": "Asking make finds every target but runs the Makefile's shell commands; reading the Makefile runs nothing.",
					"type": "enum",
					"radio": true,
					"values": [
						[null, "Use Global Setting"],
						["database", "Asking make"],
						["file", "Reading the Makefile"]
					],
					"resolve": "taskfinder.make-listing.choices",
					"default": null
				}
			]
		},
		{
			"title": "Laravel",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#laravel",
			"children": [
				{
					"key": "taskfinder.artisan-commands",
					"title": "Artisan Commands",
					"type": "enum",
					"radio": true,
					"values": [
						[null, "Use Global Setting"],
						["common", "Common"],
						["all", "All"]
					],
					"resolve": "taskfinder.artisan-commands.choices",
					"default": null
				}
			]
		}
	]
}
