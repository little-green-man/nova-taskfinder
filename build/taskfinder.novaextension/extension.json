{
	"identifier": "littlegreenman.TaskFinder",
	"name": "Automatic Tasks",
	"imageName": "icon",
	"organization": "Little Green Man Ltd",
	"description": "Automatically offers Node (npm, yarn, pnpm, bun), Composer, Taskfile, Maidfile, just, Deno, Make and Laravel artisan tasks as Nova Tasks.",
	"version": "7.3.0",
	"categories": ["tasks"],
	"homepage": "https://github.com/little-green-man/nova-taskfinder",
	"repository": "https://github.com/little-green-man/nova-taskfinder",
	"bugs": "https://github.com/little-green-man/nova-taskfinder/issues",
	"main": "main.dist.js",
	"min_runtime": "2.0",
	"activationEvents": [
		"onWorkspaceContains:package.json",
		"onWorkspaceContains:composer.json",
		"onWorkspaceContains:Taskfile.yml",
		"onWorkspaceContains:taskfile.yml",
		"onWorkspaceContains:Taskfile.yaml",
		"onWorkspaceContains:taskfile.yaml",
		"onWorkspaceContains:Taskfile.dist.yml",
		"onWorkspaceContains:taskfile.dist.yml",
		"onWorkspaceContains:Taskfile.dist.yaml",
		"onWorkspaceContains:taskfile.dist.yaml",
		"onWorkspaceContains:maidfile",
		"onWorkspaceContains:maidfile.toml",
		"onWorkspaceContains:maidfile.yaml",
		"onWorkspaceContains:maidfile.yml",
		"onWorkspaceContains:maidfile.json",
		"onWorkspaceContains:Maidfile",
		"onWorkspaceContains:Maidfile.toml",
		"onWorkspaceContains:justfile",
		"onWorkspaceContains:Justfile",
		"onWorkspaceContains:JUSTFILE",
		"onWorkspaceContains:.justfile",
		"onWorkspaceContains:deno.json",
		"onWorkspaceContains:deno.jsonc",
		"onWorkspaceContains:GNUmakefile",
		"onWorkspaceContains:makefile",
		"onWorkspaceContains:Makefile",
		"onWorkspaceContains:artisan"
	],
	"entitlements": {
		"filesystem": "readonly",
		"process": true
	},
	"commands": {
		"extensions": [
			{
				"title": "Refresh Tasks",
				"command": "taskfinder.refresh"
			}
		]
	},
	"config": [
		{
			"title": "Task Sources",
			"description": "Look for tasks in these files. Each is only read when a project has one.",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#task-sources",
			"children": [
				{
					"key": "taskfinder.auto-node",
					"title": "Node (package.json)",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-composer",
					"title": "Composer (composer.json)",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Taskfile",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Maidfile",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-just",
					"title": "just (justfile)",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-deno",
					"title": "Deno (deno.json)",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-make",
					"title": "Make (Makefile)",
					"type": "boolean",
					"default": true
				},
				{
					"key": "taskfinder.auto-artisan",
					"title": "Laravel (artisan)",
					"type": "boolean",
					"default": true
				},
				{
					"title": "Refresh Tasks",
					"description": "Re-reads every source, e.g. after installing a tool.",
					"type": "command",
					"command": "taskfinder.refresh"
				}
			]
		},
		{
			"title": "Node and Composer",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#node-and-composer",
			"children": [
				{
					"key": "taskfinder.package-manager",
					"title": "Package Manager",
					"description": "Automatic uses the project's packageManager setting or lockfile.",
					"type": "enum",
					"radio": false,
					"values": [
						["auto", "Automatic"],
						["npm", "npm"],
						["yarn", "yarn"],
						["pnpm", "pnpm"],
						["bun", "bun"]
					],
					"default": "auto"
				},
				{
					"key": "taskfinder.show-lifecycle-scripts",
					"title": "Show Lifecycle Scripts",
					"description": "Hooks such as postinstall and prebuild, and Composer events, which run automatically.",
					"type": "boolean",
					"default": false
				}
			]
		},
		{
			"title": "just",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#just",
			"children": [
				{
					"key": "taskfinder.just-confirm-recipes",
					"title": "Recipes That Ask to Confirm",
					"type": "enum",
					"radio": true,
					"values": [
						["exclude", "Hide"],
						["yes", "Show, and confirm when run"]
					],
					"default": "exclude"
				}
			]
		},
		{
			"title": "Make",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#make",
			"children": [
				{
					"key": "taskfinder.make-listing",
					"title": "Find Targets By",
					"type": "enum",
					"radio": true,
					"values": [
						["database", "Asking make: finds every target, but runs the Makefile's shell commands"],
						["file", "Reading the Makefile: runs nothing"]
					],
					"default": "database"
				}
			]
		},
		{
			"title": "Laravel",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#laravel",
			"children": [
				{
					"key": "taskfinder.artisan-commands",
					"title": "Artisan Commands",
					"description": "Common lists everyday commands and app:* commands. Listing starts the Laravel app.",
					"type": "enum",
					"radio": true,
					"values": [
						["common", "Common"],
						["all", "All"]
					],
					"default": "common"
				}
			]
		}
	],
	"configWorkspace": [
		{
			"title": "Task Sources",
			"description": "Use Global Setting follows the extension's preferences; choose another value to set it for this project only.",
			"type": "section",
			"link": "https://github.com/little-green-man/nova-taskfinder#task-sources",
			"children": [
				{
					"key": "taskfinder.auto-node",
					"title": "Node (package.json)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-node.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-composer",
					"title": "Composer (composer.json)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-composer.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-taskfile",
					"title": "Taskfile",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-taskfile.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-maidfile",
					"title": "Maidfile",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-maidfile.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-just",
					"title": "just (justfile)",
					"type": "enum",
					"radio": false,
					"values": [
						[null, "Use Global Setting"],
						[true, "On"],
						[false, "Off"]
					],
					"resolve": "taskfinder.auto-just.choices",
					"default": null
				},
				{
					"key": "taskfinder.auto-deno",
					"title": "Deno (deno.json)",
					"type": "enum",
					"radio": false,
