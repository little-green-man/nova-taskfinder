	"sidebars": [
		{
			"id": "taskfinder.sidebar",
			"name": "Tasks",
			"smallImage": "sidebar-small",
			"largeImage": "sidebar-large",
			"sections": [
				{
					"id": "taskfinder.tasks",
					"name": "Tasks",
					"allowMultiple": false,
					"placeholderText": "No tasks found in this project.",
					"headerCommands": [
						{
							"title": "Refresh",
							"image": "__builtin.refresh",
							"tooltip": "Re-read every source",
							"command": "taskfinder.refresh"
						},
						{
							"title": "Stop All",
							"image": "stop",
							"tooltip": "Stop every task started from this sidebar",
							"command": "taskfinder.sidebar.stop-all"
						}
					],
					"contextCommands": [
						{
							"title": "Run",
							"command": "taskfinder.sidebar.run",
							"when": "viewItem == 'task' || viewItem == 'finished'"
						},
						{
							"title": "Stop",
							"command": "taskfinder.sidebar.stop",
							"when": "viewItem == 'running'"
						},
						{
							"title": "Show Output",
							"command": "taskfinder.sidebar.output",
							"when": "viewItem == 'running' || viewItem == 'finished'"
						}
					]
				}
			]
		}
	]
}
