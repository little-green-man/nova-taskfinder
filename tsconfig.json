{
	"display": "Nova",
	"compilerOptions": {
		"target": "es6",
		"module": "ES2020",
		"moduleResolution": "bundler",
		"newLine": "lf",
		"strict": true,
		"noEmitOnError": true,
		"skipLibCheck": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["nova-editor-node"],
		"lib": ["es2020"]
	},
	"include": ["src"]
}
